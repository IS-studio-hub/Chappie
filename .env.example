# Service account JSON file path (local development)
GOOGLE_APPLICATION_CREDENTIALS=./weebo-409921-23c8a1cfc722.json

# Or paste the full service account JSON as a single-line string (Railway / cloud):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OAuth client credentials (Gmail Connect with Google)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Alternative: plain API key instead of service account
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server settings
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=chappie

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Products / Prices (created in Dashboard or via API)
STRIPE_PRICE_SMALL=price_...
STRIPE_PRICE_MID=price_...
STRIPE_PRICE_LARGE=price_...
STRIPE_PRODUCT_SMALL=prod_...
STRIPE_PRODUCT_MID=prod_...
STRIPE_PRODUCT_LARGE=prod_...

# System Gmail for signup verification emails (required in production)
# Option A: OAuth token JSON (from a one-time Google connect / local .gmail_token.json)
# GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":[...]}
# Option B: Gmail app password
# GMAIL_USER=hello@isexperience.house
# GMAIL_APP_PASSWORD=your_16_char_app_password

# OAuth redirect URI — must match Google Cloud Console → Credentials → OAuth client:
# Local:  http://localhost:8000/api/gmail/oauth/callback
# Prod:   https://YOUR-RAILWAY-DOMAIN/api/gmail/oauth/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

# OpenAI (optional — can also connect via UI)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
